#!/bin/sh /etc/rc.common
# 用面板灯代替失效的 USB-1/USB-2 灯：
#   上网灯(green:internet) = 随身WiFi(eth2)：连通常亮、收发闪烁
#   注册灯(green:pon)      = USB无线网卡(wifik)：热点开启常亮
# 本内核(6.12)的 netdev 触发器只有旧版 device_name/link/tx/rx 接口，
# /etc/init.d/led 写的是新版 device/mode 文件，会静默失败，故自行绑定。
START=99
STOP=10

bind() { # bind <led> <netdev> <link> <tx> <rx>
	local L=/sys/class/leds/$1
	[ -e "$L/trigger" ] || return 0
	echo netdev > "$L/trigger"
	echo "$2" > "$L/device_name"
	echo "$3" > "$L/link"
	echo "$4" > "$L/tx"
	echo "$5" > "$L/rx"
}

start() {
	bind green:internet eth2 1 1 1
	bind green:pon wifik 1 0 0
	return 0
}
