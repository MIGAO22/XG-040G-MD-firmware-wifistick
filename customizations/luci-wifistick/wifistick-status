#!/bin/sh
# 随身WiFi(RNDIS) 状态采集，输出单行 JSON，供 LuCI 设置页轮询
IF=eth2
IFACE=wanusb

auto=$(uci -q get network.$IFACE.auto); [ -n "$auto" ] || auto=1
metric=$(uci -q get network.$IFACE.metric); [ -n "$metric" ] || metric=30

present=false; [ -e /sys/class/net/$IF ] && present=true
carrier=false
if [ "$present" = true ]; then
    [ "$(cat /sys/class/net/$IF/carrier 2>/dev/null)" = 1 ] && carrier=true
fi

usb_name="-"
for d in /sys/bus/usb/devices/*/idVendor; do
    if [ "$(cat $d 2>/dev/null)" = 19d2 ]; then
        dd=$(dirname $d)
        usb_name="$(cat $dd/manufacturer 2>/dev/null | tr -d '"') $(cat $dd/product 2>/dev/null | tr -d '"')"
    fi
done

st=$(ubus call network.interface.$IFACE status 2>/dev/null)
# RNDIS 的 operstate 恒为 unknown，链路是否在线以 netifd 接口 up 为准
linked=false
[ "$(echo "$st" | jsonfilter -e '@.up' 2>/dev/null)" = true ] && linked=true
ip=$(echo "$st" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
mask=$(echo "$st" | jsonfilter -e '@["ipv4-address"][0].mask' 2>/dev/null)
gw=$(echo "$st" | jsonfilter -e '@.route[0].nexthop' 2>/dev/null)
dns=$(echo "$st" | jsonfilter -e '@["dns-server"][*]' 2>/dev/null | tr '\n' ' ')
up=$(echo "$st" | jsonfilter -e '@.uptime' 2>/dev/null)
[ -n "$ip" ] || ip="-"
[ -n "$gw" ] || gw="-"
[ -n "$dns" ] || dns="-"
[ -n "$up" ] || up=0

ping_ok=false
if [ "$linked" = true ]; then
    ping -c 1 -W 3 -I $IF 223.5.5.5 >/dev/null 2>&1 && ping_ok=true
fi

# 下载吞吐采样(约3秒截断)，单位 KB/s
speed=0
if [ "$linked" = true ]; then
    sz=$(timeout 3 wget -q -O - http://mirrors.aliyun.com/ubuntu/ls-lR.gz 2>/dev/null | wc -c)
    speed=$((sz/3/1024))
fi

agg=$(cat /sys/module/rndis_host/parameters/rx_agg_kib 2>/dev/null); [ -n "$agg" ] || agg=-1
agg_saved=$(uci -q get wifistick.global.agg_kib); [ -n "$agg_saved" ] || agg_saved=64
rxp=$(cat /sys/class/net/$IF/statistics/rx_packets 2>/dev/null); [ -n "$rxp" ] || rxp=0
rxe=$(cat /sys/class/net/$IF/statistics/rx_errors 2>/dev/null); [ -n "$rxe" ] || rxe=0
rxl=$(cat /sys/class/net/$IF/statistics/rx_length_errors 2>/dev/null); [ -n "$rxl" ] || rxl=0

printf '{"auto":%s,"metric":%s,"present":%s,"carrier":%s,"linked":%s,"ip":"%s","mask":%s,"gw":"%s","dns":"%s","uptime":%s,"ping_ok":%s,"speed":%s,"usb_name":"%s","agg_kib":%s,"agg_saved":%s,"rx_packets":%s,"rx_errors":%s,"rx_length_errors":%s}\n' \
    "$auto" "$metric" "$present" "$carrier" "$linked" "$ip" "${mask:-0}" "$gw" "$dns" "$up" "$ping_ok" "$speed" "$usb_name" "$agg" "$agg_saved" "$rxp" "$rxe" "$rxl"
